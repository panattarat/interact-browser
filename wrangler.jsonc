{
  "name": "interact-browser",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    // ให้ /api/* วิ่งเข้า Worker ก่อน ที่เหลือเสิร์ฟเป็นไฟล์ static
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "NOTE_ROOM", "class_name": "NoteRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NoteRoom"] }]
}
